# Copy to .env and fill in real secrets. .env is gitignored.
# Loaded at startup via python-dotenv (see app.py).

# API auth (Phase 1.7) — bearer token gating REST + /mcp + /ws.
# LEAVE EMPTY to disable auth (open mode — dev / trusted-LAN only; the app
# logs a startup WARNING in that case). Generate a token with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ORCHESTRATOR_API_TOKEN=

# Notifications
GOTIFY_TOKEN=

# Cloud image generation (optional; leave blank if cloud_image_gen.enabled=false)
REPLICATE_API_TOKEN=
GEMINI_API_KEY=

# Phase 2.1 Postgres durable store (optional; leave blank when postgres.enabled=false)
# Format: postgresql://orchestrator:<password>@<postgres-lxc-ip>:5432/orchestrator
POSTGRES_DSN=

# Phase 2.2 Redis ephemeral state (optional; leave blank when redis.enabled=false)
# Format: redis://:<password>@<redis-lxc-ip>:6379/0
REDIS_URL=

# Phase 2.3 OpenTelemetry tracing (optional; leave blank when otel.enabled=false)
# OTLP/gRPC endpoint, e.g. 192.168.2.187:4317 (Tempo default).
OTEL_ENDPOINT=
